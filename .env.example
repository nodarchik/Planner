# Copy to .env.local (never commit it) and paste your key after the = sign.
# Used by `vercel dev` for the in-app assistant. On Vercel the same variable is set in the project settings.
ANTHROPIC_API_KEY=
# Optional: require this password for the assistant (set it when the site is public).
# CHAT_PASSWORD=
# Shared plan edits (api/plan.js): connect a private Vercel Blob store to the project; it sets BLOB_READ_WRITE_TOKEN. `vercel env pull .env.local` copies it here.
# BLOB_READ_WRITE_TOKEN=
