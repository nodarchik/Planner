{
  "name": "palace1-apartment",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:full": "sh tools/dev-full.sh",
    "build": "vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "lint": "eslint src api",
    "check": "npm run lint && npm run validate && npm run build",
    "shots": "python3 tools/shot.py http://localhost:4173/ top,hall,bed1,bed2,bath,wc,corridor,closet,kitchen,living,office,loggiaE,top:night",
    "stills": "python3 tools/stills.py http://localhost:4173/ renders",
    "shots:diff": "python3 tools/diff.py baseline shots",
    "validate": "node tools/validate.mjs",
    "walk:test": "python3 tools/walk_test.py http://localhost:4173/",
    "sync:test": "node tools/plan_api_test.mjs && python3 tools/sync_test.py http://localhost:4173/",
    "build:single": "vite build --mode single"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@vercel/blob": "^2.9.0",
    "three": "0.160.0",
    "three-gpu-pathtracer": "0.0.23",
    "three-mesh-bvh": "0.7.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@gltf-transform/cli": "^4.5.1",
    "ajv": "^8.20.0",
    "eslint": "^9.0.0",
    "globals": "^15.0.0",
    "vite": "^5.4.0",
    "vite-plugin-singlefile": "^2.3.4"
  }
}
